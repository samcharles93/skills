#!/bin/sh
# Reject a pushed tag whose name disagrees with the plugin version.
root=$(git rev-parse --show-toplevel)
status=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
	case "$remote_ref" in
	refs/tags/*)
		"$root/scripts/check-versions.sh" --tag "${remote_ref#refs/tags/}" || status=1
		;;
	esac
done
exit $status
